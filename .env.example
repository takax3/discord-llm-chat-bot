# =========================
# Discord bot の基本設定
# =========================
# Discord bot のトークン。必須。
DISCORD_BOT_TOKEN=

# メンションされたが本文が空だったときの案内文。
DISCORD_MENTION_RESPONSE=Hello! Discord bot is connected and ready.


# =========================
# Ollama 接続設定
# =========================
# Ollama への接続 URL。ホストで起動している場合は host.docker.internal を使う。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 通常応答と検索要否判定の両方に使うモデル。
OLLAMA_MODEL=gemma4:26b

# 1 回の Ollama リクエストに対するタイムアウト秒数。
OLLAMA_TIMEOUT_SECONDS=180

# 進捗ステップ（判定中・検索完了）を積み重ねて表示するかどうか。
# false: 各ステップが前のステップを上書きして表示される。
# true: 完了したステップが残り、推論中のステップが末尾に追加される。
SHOW_STEPS=false


# Discord 接続前にモデルを warmup するかどうか。
OLLAMA_PREWARM_ENABLED=true
OLLAMA_PREWARM_PROMPT=こんにちは。準備ができたら一言だけ返答してください。


# =========================
# 画像入力設定
# =========================
# vision 対応モデルで画像添付入力を使うかどうか。
VISION_ENABLED=true

# 画像だけが添付され、本文がないときに使う既定プロンプト。
VISION_IMAGE_ONLY_PROMPT=この画像に写っているものを推定して、簡潔に説明してください。

# 画像縮小後の最大画素数。
VISION_MAX_PIXELS=2073600


# =========================
# Web 検索補強設定
# =========================
# 有効時は、まずモデルが Web 検索の要否を判定する。
WEB_SEARCH_ENABLED=false

# Brave Search API のキー。WEB_SEARCH_ENABLED=true のとき必須。
BRAVE_SEARCH_API_KEY=

# 回答に使い、参考 URL として表示する最大件数。
WEB_SEARCH_MAX_RESULTS=3

# Brave Search API 1 回あたりのタイムアウト秒数。
WEB_SEARCH_TIMEOUT_SECONDS=10

# Brave Search の地域設定。
WEB_SEARCH_COUNTRY=JP
WEB_SEARCH_LANGUAGE=jp


# =========================
# プロンプトと応答制御
# =========================
# モデルへ渡す基本 system prompt。
SYSTEM_PROMPT=You are a helpful Discord assistant.

# ギルド設定が未登録のときに使う許可チャンネル一覧。
# Discord チャンネル ID をカンマ区切りで指定。空なら全チャンネル許可。
DEFAULT_ALLOWED_CHANNEL_IDS=

# reply 文脈に含める過去メッセージ数の上限。
MAX_HISTORY_MESSAGES=20

# Discord へ返す最終応答の文字数上限。
MAX_RESPONSE_CHARS=1800


# =========================
# ログと webhook 通知
# =========================
LOG_LEVEL=INFO

# 起動 / 終了 / ログ通知に使う Discord webhook URL。
# 複数指定する場合はカンマ区切り。空なら webhook 通知は無効。
# 例: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy,https://discord.com/api/webhooks/aaa/bbb
DISCORD_WEBHOOK_URL=

# 各 webhook 通知の有効 / 無効。
DISCORD_WEBHOOK_NOTIFY_STARTUP=true
DISCORD_WEBHOOK_NOTIFY_SHUTDOWN=true
DISCORD_WEBHOOK_NOTIFY_LOGS=false

# 通常ログを webhook 転送する最小ログレベル。
DISCORD_WEBHOOK_NOTIFY_LOGS_MIN_LEVEL=ERROR


# =========================
# ローカル永続化データ
# =========================
DATA_DIR=./data
SQLITE_PATH=./data/discordbot.db
